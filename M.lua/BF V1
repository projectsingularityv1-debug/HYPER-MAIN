	if not bossName or bossName == "" then return false end
	for _, v in pairs(game.ReplicatedStorage:GetChildren()) do
		if string.find(v.Name, bossName) and v.ClassName == "Model" and v:FindFirstChild("Humanoid") then return true end
	end
	for _, v in pairs(workspace.Enemies:GetChildren()) do
		if string.find(v.Name, bossName) and v.ClassName == "Model" and v:FindFirstChild("Humanoid") then return true end
	end
	for i, v in pairs(workspace._WorldOrigin.EnemySpawns:GetChildren()) do
		if (string.find(v.Name, bossName) or string.find(bossName, v.Name)) then return true end
	end
	return false
end

